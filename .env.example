# Telegram MTProto Configuration (Development Credentials from my.telegram.org)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here
TELEGRAM_CHAT_ID=me

# Turso / libSQL Configuration
# For local SQLite: file:local.db
# For Turso Cloud: libsql://your-db-name.turso.io
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Encryption Configuration (Must be 32 bytes / 64 hex chars or random key)
MASTER_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# Server Configuration
SERVER_PORT=3060
