# ============================================================
# MengDrive — configuration
# Copy to .env and fill in:  cp .env.example .env
# ============================================================

# --- Telegram MTProto (from https://my.telegram.org → API Development Tools) ---
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=your_api_hash_here

# --- Turso / libSQL ---
# Local SQLite (default, stored on the Docker volume /data):
TURSO_DATABASE_URL=file:/data/local.db
TURSO_AUTH_TOKEN=
# Or Turso Cloud:
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=eyJ...

# --- Encryption (only used for legacy AES-GCM chunks; new uploads are plaintext) ---
# Generate: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

# --- Server ---
# Host port to expose (container always listens on 3060)
MENGDRIVE_PORT=3060

# --- Logging ---
RUST_LOG=info
